workflow_ref() {
  local repo="$1"
  grep 'uses:' "$repo/.github/workflows/build.yml"
}

assert_structured_output_clean() {
  local output="$1"

  [[ "$output" != *"Checking "* ]] ||
    fail "structured output should not include quiet scan context"
  [[ "$output" != *"Finished."* ]] ||
    fail "structured output should not include the final status"
  [[ "$output" != *"Findings in "* ]] ||
    fail "structured output should not include regular findings text"
}

test_option_validation() {
  local output
  local option_output="$TMP_ROOT/option-validation.out"

  output=$("$SCRIPT" -h)
  [[ "$output" == *"Usage: actions-snitch [-c] [-u] [-s] [-f] [-p] [-b branch] [-o format] [-t] [-v] [-h]"* ]] ||
    fail "help output does not document the expected usage"
  output=$(TERM=dumb "$SCRIPT" -h)
  [[ "$output" == *"Usage: actions-snitch [-c] [-u] [-s] [-f] [-p] [-b branch] [-o format] [-t] [-v] [-h]"* ]] ||
    fail "help output should work without color-capable terminal settings"
  [[ "$output" == *"  -o    Output findings as json, md, or yaml"* ]] ||
    fail "help output does not document the output option"
  [[ "$output" == *"  -t    Only update actions from GitHub Marketplace verified creators"* ]] ||
    fail "help output does not document the verified-creator update option"

  if "$SCRIPT" -b sample >"$option_output" 2>&1; then
    fail "-b without -u or -p unexpectedly succeeded"
  fi

  output=$(cat "$option_output")
  [[ "$output" == *"Error: -b can only be used with -u or -p"* ]] ||
    fail "-b without -u or -p did not print the expected error"

  if "$SCRIPT" -t >"$option_output" 2>&1; then
    fail "-t without -u or -p unexpectedly succeeded"
  fi

  output=$(cat "$option_output")
  [[ "$output" == *"Error: -t can only be used with -u or -p"* ]] ||
    fail "-t without -u or -p did not print the expected error"
}

test_update_in_place() {
  local case_dir="$TMP_ROOT/update-in-place"
  local bin_dir="$case_dir/bin"
  local repo="$case_dir/repo"

  mkdir -p "$repo"
  write_stubs "$bin_dir" 90
  init_workflow_repo "$repo"

  (cd "$repo" && PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/cache" TERM=dumb "$SCRIPT" -u >/dev/null)

  [[ "$(workflow_ref "$repo")" == *"actions/checkout@v4"* ]] ||
    fail "-u did not update the workflow in-place"
  [[ "$(git -C "$repo" rev-list --count HEAD)" == "1" ]] ||
    fail "-u should not create a commit"
  [[ "$(git -C "$repo" branch --show-current)" == "main" ]] ||
    fail "-u should stay on the current branch"
}

test_update_branch_creation() {
  local case_dir="$TMP_ROOT/update-branch"
  local bin_dir="$case_dir/bin"
  local repo="$case_dir/repo"

  mkdir -p "$repo"
  write_stubs "$bin_dir" 90
  init_workflow_repo "$repo"

  (cd "$repo" && PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/cache" "$SCRIPT" -u -b actions-update >/dev/null)

  [[ "$(git -C "$repo" branch --show-current)" == "actions-update" ]] ||
    fail "-u -b did not switch to the target branch"
  [[ "$(workflow_ref "$repo")" == *"actions/checkout@v4"* ]] ||
    fail "-u -b did not update the workflow"
  [[ "$(git -C "$repo" rev-list --count HEAD)" == "1" ]] ||
    fail "-u -b should not create a commit"
}

test_force_gate() {
  local skip_dir="$TMP_ROOT/force-skip"
  local force_dir="$TMP_ROOT/force-apply"

  mkdir -p "$skip_dir/repo" "$force_dir/repo"
  write_stubs "$skip_dir/bin" 50
  write_stubs "$force_dir/bin" 50
  init_workflow_repo "$skip_dir/repo"
  init_workflow_repo "$force_dir/repo"

  (cd "$skip_dir/repo" && PATH="$skip_dir/bin:$PATH" XDG_CACHE_HOME="$skip_dir/cache" "$SCRIPT" -u >/dev/null)
  [[ "$(workflow_ref "$skip_dir/repo")" == *"actions/checkout@v2"* ]] ||
    fail "-u should skip low compatibility updates"

  (cd "$force_dir/repo" && PATH="$force_dir/bin:$PATH" XDG_CACHE_HOME="$force_dir/cache" "$SCRIPT" -u -f >/dev/null)
  [[ "$(workflow_ref "$force_dir/repo")" == *"actions/checkout@v4"* ]] ||
    fail "-u -f should apply low compatibility updates"
}

test_ai_allows_low_score_update_and_redacts_context() {
  local case_dir="$TMP_ROOT/ai-allow"
  local bin_dir="$case_dir/bin"
  local repo="$case_dir/repo"
  local llm_log="$case_dir/llm"
  local args prompt

  mkdir -p "$repo"
  write_stubs "$bin_dir" 50
  write_ai_stub "$bin_dir" allow "$llm_log"
  init_ai_workflow_repo "$repo"

  (cd "$repo" && PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/cache" ACTIONS_SNITCH_AI=true ACTIONS_SNITCH_AI_MODEL=test-model "$SCRIPT" -u >/dev/null)

  [[ "$(workflow_ref "$repo")" == *"actions/checkout@v4"* ]] ||
    fail "AI allow decision should apply a low compatibility update"
  args=$(cat "${llm_log}.args")
  [[ "$args" == *"--no-log"* && "$args" == *"--schema"* && "$args" == *"--model test-model"* ]] ||
    fail "AI invocation should disable logging and request schema-constrained output"
  prompt=$(cat "${llm_log}.prompt")
  [[ "$prompt" == *'"fetch-depth":0'* ]] ||
    fail "AI evidence should include the action's exact input configuration"
  [[ "$prompt" == *'"action_lines":['* ]] ||
    fail "AI evidence should include stable action line selectors"
  [[ "$prompt" == *'"<redacted>"'* ]] ||
    fail "AI evidence should mark redacted values"
  [[ "$prompt" != *"TOP_SECRET_MARKER"* && "$prompt" != *"CHECKOUT_TOKEN"* ]] ||
    fail "AI evidence should not include environment values or secret expressions"
}

test_ai_rejects_unsafe_remediation() {
  local case_dir="$TMP_ROOT/ai-unsafe-remediation"
  local bin_dir="$case_dir/bin"
  local repo="$case_dir/repo"
  local output

  mkdir -p "$repo"
  write_stubs "$bin_dir" 50
  write_ai_stub "$bin_dir" unsafe-remediation "$case_dir/llm"
  init_ai_workflow_repo "$repo"

  output=$(cd "$repo" && PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/cache" ACTIONS_SNITCH_AI=true ACTIONS_SNITCH_AI_MODEL=test-model TERM=dumb "$SCRIPT" -u)

  [[ "$(workflow_ref "$repo")" == *"actions/checkout@v2"* ]] ||
    fail "a sensitive-input AI remediation should fail closed"
  [[ "$(yq -r '.jobs.build.steps[0].with.fetch-depth' "$repo/.github/workflows/build.yml")" == "0" ]] ||
    fail "a rejected AI remediation should not change workflow inputs"
  [[ "$output" == *"could not be safely validated and applied"* ]] ||
    fail "a rejected AI remediation should explain why the update was skipped"
}

test_ai_review_and_invalid_output_fail_closed() {
  local review_dir="$TMP_ROOT/ai-review"
  local invalid_dir="$TMP_ROOT/ai-invalid"
  local output

  mkdir -p "$review_dir/repo" "$invalid_dir/repo"
  write_stubs "$review_dir/bin" 50
  write_ai_stub "$review_dir/bin" review "$review_dir/llm"
  init_ai_workflow_repo "$review_dir/repo"

  output=$(cd "$review_dir/repo" && PATH="$review_dir/bin:$PATH" XDG_CACHE_HOME="$review_dir/cache" ACTIONS_SNITCH_AI=true ACTIONS_SNITCH_AI_MODEL=test-model TERM=dumb "$SCRIPT" -u)
  [[ "$(workflow_ref "$review_dir/repo")" == *"actions/checkout@v2"* ]] ||
    fail "AI review decision should leave a low compatibility update unchanged"
  [[ "$output" == *"after AI decision 'review'"* ]] ||
    fail "AI review decision should explain why the update was skipped"

  write_stubs "$invalid_dir/bin" 50
  write_ai_stub "$invalid_dir/bin" invalid "$invalid_dir/llm"
  init_ai_workflow_repo "$invalid_dir/repo"

  (cd "$invalid_dir/repo" && PATH="$invalid_dir/bin:$PATH" XDG_CACHE_HOME="$invalid_dir/cache" ACTIONS_SNITCH_AI=true ACTIONS_SNITCH_AI_MODEL=test-model "$SCRIPT" -u >/dev/null)
  [[ "$(workflow_ref "$invalid_dir/repo")" == *"actions/checkout@v2"* ]] ||
    fail "invalid AI output should fail closed"
}

test_ai_config_adds_investigation_to_pr_body() {
  local case_dir="$TMP_ROOT/ai-pr-body"
  local bin_dir="$case_dir/bin"
  local repo="$case_dir/repo"
  local origin="$case_dir/origin.git"
  local pr_log="$case_dir/pr.log"
  local config_dir="$case_dir/config/actions-snitch"
  local body

  mkdir -p "$repo" "$config_dir"
  write_stubs "$bin_dir" 50 "$pr_log"
  write_ai_stub "$bin_dir" remediate "$case_dir/llm"
  init_ai_workflow_repo "$repo"
  cat > "$config_dir/config.yaml" <<'YAML'
ai:
  enabled: true
  backend: llm
  model: test-model
  threshold: 80
  issue_search: auto
YAML
  git init --bare -q "$origin"
  git -C "$repo" remote add origin "$origin"
  git -C "$repo" push -q -u origin main

  (cd "$repo" && PATH="$bin_dir:$PATH" XDG_CONFIG_HOME="$case_dir/config" XDG_CACHE_HOME="$case_dir/cache" "$SCRIPT" -p -b actions-update >/dev/null)

  body=$(cat "$pr_log")
  [[ "$body" == *"<summary>Investigation: Compatibility & Safety Details</summary>"* ]] ||
    fail "AI-assisted PR body should include a collapsible investigation section"
  [[ "$body" == *"* **Caution Detail:** Checkout fetch behavior changed."* ]] ||
    fail "AI-assisted PR body should include the compatibility caution"
  [[ "$body" == *"* **Safety:** Using fetch-depth 1 avoids the incompatible full-history behavior."* ]] ||
    fail "AI-assisted PR body should include the configuration-specific safety finding"
  [[ "$body" == *"* **Remediation:** Set <code>fetch-depth</code> from <code>0</code> to <code>1</code>"* ]] ||
    fail "AI-assisted PR body should describe the applied remediation"
  [[ "$body" == *"* **Remediation:** Remove <code>clean</code> (currently <code>true</code>)"* ]] ||
    fail "AI-assisted PR body should describe a removed action input"
  [[ "$(yq -r '.jobs.build.steps[0].with.fetch-depth' "$repo/.github/workflows/build.yml")" == "1" ]] ||
    fail "AI remediation should update the approved action input"
  [[ "$(yq -r '.jobs.build.steps[0].with | has("clean")' "$repo/.github/workflows/build.yml")" == "false" ]] ||
    fail "AI remediation should remove the approved action input"
  [[ "$body" == *"<sub>Findings and PR created by [actions-snitch](https://github.com/wallentx/actions-snitch).</sub>"* ]] ||
    fail "AI-assisted PR body should retain the linked actions-snitch footer"
}

test_verified_creator_update_gate() {
  local case_dir="$TMP_ROOT/verified-creator-update"
  local bin_dir="$case_dir/bin"
  local repo="$case_dir/repo"

  mkdir -p "$repo"
  write_multi_action_stubs "$bin_dir"
  init_multi_finding_repo "$repo"

  (cd "$repo" && PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/cache" "$SCRIPT" -u -f -t >/dev/null)

  grep -q 'actions/checkout@v4' "$repo/.github/workflows/build.yml" ||
    fail "-u -f -t should update verified creator actions"
  grep -q 'docker/setup-buildx-action@v1' "$repo/.github/workflows/build.yml" ||
    fail "-u -f -t should leave unverified creator actions unchanged"
  ! grep -q 'docker/setup-buildx-action@v3' "$repo/.github/workflows/build.yml" ||
    fail "-u -f -t should not update unverified creator actions"
}

test_quiet_scan_prints_current_directory() {
  local case_dir="$TMP_ROOT/quiet-scan"
  local bin_dir="$case_dir/bin"
  local repo="$case_dir/repo"
  local output

  mkdir -p "$repo"
  write_stubs "$bin_dir" 90
  init_workflow_repo "$repo"

  output=$(cd "$repo" && PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/cache" "$SCRIPT")

  [[ "$output" == *"Checking $repo"* ]] ||
    fail "quiet scan output did not include the current directory"
  [[ "$output" == *"Finished."* ]] ||
    fail "quiet scan output did not include the final status"
  [[ "$output" == *"Checking $repo"*"Finished."* ]] ||
    fail "quiet scan output should print the current directory before the final status"
  [[ "$output" == *"☑️ actions/checkout is outdated:"* ]] ||
    fail "quiet scan output should mark verified creators"
}

