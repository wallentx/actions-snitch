    fail "markdown output should be empty when there are no findings"

  yaml_output=$(cd "$repo" && PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/yaml-cache" "$SCRIPT" -o yaml)
  [[ -z "$yaml_output" ]] ||
    fail "yaml output should be empty when there are no findings"
}

test_commit_sha_default_branch_finding_has_no_release_notes_url() {
  local case_dir="$TMP_ROOT/commit-sha-default-branch"
  local bin_dir="$case_dir/bin"
  local repo="$case_dir/actions-snitch-fixture"
  local repo_name output

  mkdir -p "$repo"
  write_commit_sha_default_branch_stubs "$bin_dir"
  init_commit_sha_repo "$repo"
  repo_name=$(basename "$repo")

  output=$(cd "$repo" && TEST_SHA_NO_RELEASE=true TEST_SHA_UNTAGGED=true PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/cache" "$SCRIPT" -o json)

  [[ "$(jq -r --arg repo "$repo_name" '.[$repo][0].latest' <<< "$output")" == "main" ]] ||
    fail "commit SHA finding should report the default branch as latest"
  [[ "$(jq -r --arg repo "$repo_name" '.[$repo][0].release_notes' <<< "$output")" == "null" ]] ||
    fail "commit SHA default-branch finding should not emit a release-notes URL"
  [[ "$output" != *"/releases/tag/vmain"* ]] ||
    fail "commit SHA default-branch finding should not emit a vmain release URL"
}

test_commit_sha_release_uses_tag_ref_for_commit_lookup() {
  local case_dir="$TMP_ROOT/commit-sha-release"
  local bin_dir="$case_dir/bin"
  local repo="$case_dir/actions-snitch-fixture"
  local repo_name output

  mkdir -p "$repo"
  write_commit_sha_release_stubs "$bin_dir"
  init_commit_sha_repo "$repo"
  repo_name=$(basename "$repo")

  output=$(cd "$repo" && PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/cache" "$SCRIPT" -o json)

  [[ "$(jq -r --arg repo "$repo_name" '.[$repo][0].latest' <<< "$output")" == "7.0.1" ]] ||
    fail "commit SHA finding should resolve the latest release through its v-prefixed tag"
}

test_sha_reporting_and_updates() {
  local case_dir="$TMP_ROOT/sha-reporting" bin_dir="$TMP_ROOT/sha-reporting/bin"
  local repo="$case_dir/repo" output format
  mkdir -p "$repo"
  write_sha_stubs "$bin_dir"
  init_commit_sha_repo "$repo"
  output=$(cd "$repo" && TERM=dumb PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/cache" "$SCRIPT" -v)
  [[ "$output" == *"Current SHA matches tag: v6.1.0"* ]] || fail "SHA should match earliest full tag across all pages"
  [[ "$output" == *"Latest SHA: bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"* ]] || fail "human findings need latest SHA"
  output=$(cd "$repo" && TEST_SHA_NUMERIC_TAG=true PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/numeric" "$SCRIPT" -o yaml)
  [[ "$(yq '.repo[0].current_tag | tag' <<< "$output")" == "!!str" ]] || fail "numeric tag names must remain YAML strings"
  for format in json yaml md; do
    output=$(cd "$repo" && PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/cache" "$SCRIPT" -o "$format")
    [[ "$output" == *v6.1.0* && "$output" == *bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb* ]] || fail "$format should include SHA translation"
    if [[ "$format" == json ]]; then
      jq -e '.repo[0] | .current_tag == "v6.1.0" and .latest_sha == "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" and .commits_since == 302 and .update_ref == .latest_sha' <<< "$output" >/dev/null || fail "SHA structured metadata incorrect"
    fi
  done
  (cd "$repo" && PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/cache" "$SCRIPT" -u >/dev/null)
  [[ "$(yq '.jobs.build.steps[0].uses' "$repo/.github/workflows/build.yml")" == actions/checkout@bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb ]] || fail "SHA update must stay a bare SHA without -s"
  output=$(cd "$repo" && PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/cache" "$SCRIPT" -o json)
  [[ -z "$output" ]] || fail "same SHA as latest must produce no finding"
}

test_sha_untagged_and_failed_comparisons() {
  local case_dir="$TMP_ROOT/sha-untagged" bin_dir="$TMP_ROOT/sha-untagged/bin"
  local repo="$case_dir/repo" output status
  mkdir -p "$repo"
  write_sha_stubs "$bin_dir"
  init_commit_sha_repo "$repo"
  output=$(cd "$repo" && TERM=dumb TEST_SHA_UNTAGGED=true PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/untagged" "$SCRIPT" -v)
  [[ "$output" == *"Commits since: 302"* && "$output" != *"Current SHA matches tag:"* ]] || fail "untagged SHA needs complete commit count, not a guessed tag"
  for status in behind diverged identical; do
    output=$(cd "$repo" && TEST_SHA_STATUS="$status" PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/$status" "$SCRIPT" -u -f -o json 2>"$case_dir/error")
    [[ -z "$output" ]] || fail "$status must not be reported as outdated"
    grep -q 'actions/checkout@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa' "$repo/.github/workflows/build.yml" || fail "$status must not rewrite SHA"
  done
  output=$(cd "$repo" && TEST_SHA_COMPARE_FAIL=true PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/failed" "$SCRIPT" -u -o json 2>"$case_dir/error")
  [[ -z "$output" ]] || fail "failed comparison must not invent a finding"
  grep -q 'Unable to compare' "$case_dir/error" || fail "failed comparison must be visible"
  output=$(cd "$repo" && TEST_SHA_TAGS_FAIL=true PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/tags-failed" "$SCRIPT" -o json 2>"$case_dir/error")
  jq -e '.repo[0] | .current_tag == null and .commits_since == 302' <<< "$output" >/dev/null || fail "tag failure should retain proven commit distance"
  grep -q 'Unable to look up tags' "$case_dir/error" || fail "tag lookup failure must not masquerade as no matching tags"
}

test_sha_pin_option_and_policy() {
  local case_dir="$TMP_ROOT/sha-pin" bin_dir="$TMP_ROOT/sha-pin/bin"
  local repo="$case_dir/repo" output ref
  mkdir -p "$repo"
  write_sha_stubs "$bin_dir" 90
  init_workflow_repo "$repo"
  for ref in v2 v7 v7.0.1 7.0.1; do
    REF="$ref" yq -i '.jobs.build.steps[0].uses = "actions/checkout@" + strenv(REF)' "$repo/.github/workflows/build.yml"
    output=$(cd "$repo" && PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/cache" "$SCRIPT" -s -o json)
    jq -e '.repo[0].update_ref == "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"' <<< "$output" >/dev/null || fail "-s must preview pin for $ref"
    [[ "$(yq '.jobs.build.steps[0].uses' "$repo/.github/workflows/build.yml")" == "actions/checkout@$ref" ]] || fail "-s alone must not mutate"
    (cd "$repo" && PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/cache" "$SCRIPT" -u -s >/dev/null)
    [[ "$(yq '.jobs.build.steps[0].uses' "$repo/.github/workflows/build.yml")" == actions/checkout@bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb ]] || fail "-s must pin $ref"
  done
  yq -i '.jobs.build.steps[0].uses = "actions/checkout@v2"' "$repo/.github/workflows/build.yml"
  (cd "$repo" && TEST_SHA_RESOLVE_FAIL=true PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/resolve-failed" "$SCRIPT" -u -s >/dev/null 2>&1)
  grep -q 'actions/checkout@v2' "$repo/.github/workflows/build.yml" || fail "failed SHA resolution must not fall back to tag update"
  write_sha_stubs "$bin_dir" 50
  yq -i '.jobs.build.steps[0].uses = "actions/checkout@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"' "$repo/.github/workflows/build.yml"
  (cd "$repo" && PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/low" "$SCRIPT" -u >/dev/null)
  grep -q 'actions/checkout@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa' "$repo/.github/workflows/build.yml" || fail "SHA updates must respect compatibility gate"
  (cd "$repo" && PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/low" "$SCRIPT" -u -f >/dev/null)
  grep -q 'actions/checkout@bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb' "$repo/.github/workflows/build.yml" || fail "-f must allow low-score SHA update"
}

test_sha_pin_non_semver_targets() {
  local case_dir="$TMP_ROOT/sha-pin-non-semver" bin_dir="$TMP_ROOT/sha-pin-non-semver/bin"
  local repo="$case_dir/repo" variant mode output expected_latest cache before current_ref
  local -a target_env resolve_env
  mkdir -p "$repo"
  write_sha_stubs "$bin_dir" 90
  init_workflow_repo "$repo"
  for variant in default-branch non-semver-release current-non-semver-release current-v-prefixed-release; do
    current_ref=v2
    if [[ "$variant" == default-branch ]]; then
      target_env=(TEST_SHA_NO_RELEASE=true)
      expected_latest=main
    elif [[ "$variant" == current-v-prefixed-release ]]; then
      target_env=(TEST_SHA_RELEASE=vstable)
      expected_latest=stable
      current_ref=vstable
    else
      target_env=(TEST_SHA_RELEASE=release-stable)
      expected_latest=release-stable
      if [[ "$variant" == current-non-semver-release ]]; then current_ref=release-stable; fi
    fi
    for mode in success api-failure invalid-sha; do
      REF="$current_ref" yq -i '.jobs.build.steps[0].uses = "actions/checkout@" + strenv(REF)' "$repo/.github/workflows/build.yml"
      before=$(cat "$repo/.github/workflows/build.yml")
      cache="$case_dir/$variant-$mode"
      resolve_env=()
      case "$mode" in
        api-failure) resolve_env=(TEST_SHA_RESOLVE_FAIL=true) ;;
        invalid-sha) resolve_env=(TEST_SHA_LATEST=main) ;;
      esac
      if [[ "$mode" == success && "$variant" == current-* ]]; then
        output=$(cd "$repo" && env "${target_env[@]}" PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$cache" "$SCRIPT" -u -o json)
        [[ -z "$output" && "$(cat "$repo/.github/workflows/build.yml")" == "$before" ]] || fail "current non-semver tag must stay unchanged without -s"
        output=$(cd "$repo" && env "${target_env[@]}" PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$cache" "$SCRIPT" -s -o json)
        jq -e '.repo[0].update_ref == "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"' <<< "$output" >/dev/null || fail "-s must preview a pin for $variant"
        [[ "$(cat "$repo/.github/workflows/build.yml")" == "$before" ]] || fail "-s preview must not modify $variant"
      fi
      output=$(cd "$repo" && env "${target_env[@]}" "${resolve_env[@]}" PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$cache" "$SCRIPT" -u -s -o json 2>"$case_dir/error")
      if [[ "$mode" == success ]]; then
        [[ "$(yq '.jobs.build.steps[0].uses' "$repo/.github/workflows/build.yml")" == actions/checkout@bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb ]] || fail "-s must resolve $variant to a full SHA"
        jq -e --arg latest "$expected_latest" '.repo[0] | .latest == $latest and .latest_sha == "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" and .update_ref == .latest_sha' <<< "$output" >/dev/null || fail "$variant report must identify the actual SHA target"
      else
        [[ "$(cat "$repo/.github/workflows/build.yml")" == "$before" ]] || fail "$variant $mode must leave the workflow unchanged"
        [[ -z "$output" ]] || fail "$variant $mode must not propose a mutable ref"
        grep -q 'Unable to resolve' "$case_dir/error" || fail "$variant $mode must report the resolution failure"
      fi
    done
  done
}

test_sha_subpaths_and_default_branch() {
  local case_dir="$TMP_ROOT/sha-subpaths" bin_dir="$TMP_ROOT/sha-subpaths/bin"
  local repo="$case_dir/repo" output
  mkdir -p "$repo/.github/actions/helper"
  write_sha_stubs "$bin_dir"
  init_commit_sha_repo "$repo"
  cat > "$repo/.github/actions/helper/action.yml" <<'YAML'
name: Helper
runs:
  using: composite
  steps:
    - uses: actions/checkout/helper@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
      with:
        token: example
YAML
  (cd "$repo" && TEST_SHA_NO_RELEASE=true TEST_SHA_UNTAGGED=true PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/cache" "$SCRIPT" -u >/dev/null)
  [[ "$(yq '.runs.steps[0].uses' "$repo/.github/actions/helper/action.yml")" == actions/checkout/helper@bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb ]] || fail "default branch SHA update must preserve action subpath"
  [[ "$(yq '.runs.steps[0].with.token' "$repo/.github/actions/helper/action.yml")" == example ]] || fail "SHA update must preserve inputs"
  output=$(cd "$repo" && TEST_SHA_NO_RELEASE=true PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/cache" "$SCRIPT" -o json)
  [[ -z "$output" ]] || fail "default branch pins must be idempotent"
}

test_sha_pr_flow() {
  local case_dir="$TMP_ROOT/sha-pr" bin_dir="$TMP_ROOT/sha-pr/bin"
  local repo="$case_dir/repo" origin="$case_dir/origin.git" body
  mkdir -p "$repo"
  write_sha_stubs "$bin_dir" 90 "$case_dir/pr.log"
  init_commit_sha_repo "$repo"
  git init --bare -q "$origin"
  git -C "$repo" remote add origin "$origin"
  git -C "$repo" push -q -u origin main
  (cd "$repo" && PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/cache" "$SCRIPT" -p -b actions-update >/dev/null)
  body=$(cat "$case_dir/pr.log")
  [[ "$body" == *"Current SHA matches tag: \`v6.1.0\`"* ]] || fail "PR must translate current SHA"
  [[ "$body" == *'actions/checkout@bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb'* ]] || fail "PR must show exact updated pin"
  [[ "$body" != *vaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa* ]] || fail "PR links must not prepend v to SHA"
  [[ -z "$(git -C "$repo" status --short)" ]] || fail "SHA PR should commit all updates"
}

test_snitchignore() {
  local case_dir="$TMP_ROOT/snitchignore" bin_dir="$TMP_ROOT/snitchignore/bin"
  local repo="$case_dir/repo" output
  mkdir -p "$repo"
  write_stubs "$bin_dir" 90
  init_yaml_and_composite_repo "$repo"
  mkdir -p "$repo/.test/clone/.github/actions/sample" "$repo/fixtures with spaces"
  cp "$repo/.github/actions/helper/action.yml" "$repo/.test/clone/.github/actions/sample/action.yml"
  cp "$repo/.github/actions/helper/action.yml" "$repo/fixtures with spaces/action.yaml"
  # CRLF, comments, a final line without newline, glob, directory and negation.
  printf '# fixtures\r\n.test/\r\nfixtures with spaces/\r\n.github/workflows/*.yaml\n.github/actions/\n!.github/actions/helper/action.yml' > "$repo/.snitchignore"
  output=$(cd "$repo" && PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/cache" "$SCRIPT" -o json)
  jq -e '.repo | length == 1 and .[0].file == ".github/actions/helper/action.yml"' <<< "$output" >/dev/null || fail "ignore must filter workflows and nested fixtures, respecting negation"
  (cd "$repo" && PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/cache" "$SCRIPT" -u >/dev/null)
  grep -q 'actions/cache@v5' "$repo/.test/clone/.github/actions/sample/action.yml" || fail "ignored fixtures must not be updated"
  grep -q 'actions/cache@v5' "$repo/fixtures with spaces/action.yaml" || fail "ignored paths with spaces must not be updated"
  grep -q 'actions/checkout@v2' "$repo/.github/workflows/build.yaml" || fail "ignored workflows must not be updated"
  grep -q 'actions/cache@v6' "$repo/.github/actions/helper/action.yml" || fail "re-included composite action must update"
}

test_output_format_validation() {
  local case_dir="$TMP_ROOT/output-format-validation"
  local bin_dir="$case_dir/bin"
  local repo="$case_dir/repo"
  local output_file="$case_dir/output.out"

  mkdir -p "$repo"
  write_stubs "$bin_dir" 90
  init_workflow_repo "$repo"

  if (cd "$repo" && PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/cache" "$SCRIPT" -o xml >"$output_file" 2>&1); then
    fail "-o xml unexpectedly succeeded"
  fi

  [[ "$(cat "$output_file")" == *"Error: -o must be one of: json, md, yaml"* ]] ||
    fail "-o xml did not print the expected validation error"
}

test_pr_flow() {
  local case_dir="$TMP_ROOT/pr-flow"
  local bin_dir="$case_dir/bin"
  local repo="$case_dir/repo"
  local origin="$case_dir/origin.git"
  local pr_log="$case_dir/pr.log"

  mkdir -p "$repo"
  write_stubs "$bin_dir" 90 "$pr_log"
  init_workflow_repo "$repo"
  git init --bare -q "$origin"
  git -C "$repo" remote add origin "$origin"
  git -C "$repo" push -q -u origin main

  (cd "$repo" && PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/cache" "$SCRIPT" -p -b actions-update >/dev/null)

  [[ "$(git -C "$repo" branch --show-current)" == "actions-update" ]] ||
    fail "-p -b did not switch to the target branch"
  [[ "$(workflow_ref "$repo")" == *"actions/checkout@v4"* ]] ||
    fail "-p -b did not update the workflow"
  [[ "$(git -C "$repo" rev-list --count HEAD)" == "2" ]] ||
    fail "-p -b should create one commit"
  [[ -z "$(git -C "$repo" status --short)" ]] ||
    fail "-p -b should leave the worktree clean"
  git --git-dir="$origin" show-ref --verify --quiet refs/heads/actions-update ||
    fail "-p -b did not push the target branch"
  [[ "$(cat "$pr_log")" == *"--head actions-update --base main"* ]] ||
    fail "-p -b did not create a PR for the target branch"
  [[ "$(cat "$pr_log")" == *"--repo https://github.com/wallentx/actions-snitch-fixture"* ]] ||
    fail "-p must explicitly select the origin repository"
  [[ "$(cat "$pr_log")" == *"Bumps the github-actions group with 1 update: [actions/checkout](https://github.com/actions/checkout)."* ]] ||
    fail "PR body should include the Dependabot-inspired summary"
  [[ "$(cat "$pr_log")" == *"Updates \`actions/checkout\` from 2 to 4"* ]] ||
    fail "PR body should include the action version update"
  [[ "$(cat "$pr_log")" == *"<summary>Release notes</summary>"* ]] ||
    fail "PR body should include collapsible release notes"
  [[ "$(cat "$pr_log")" == *"Sourced from [actions/checkout's releases](https://github.com/actions/checkout/releases)."* ]] ||
    fail "PR body should link to release notes source"
  [[ "$(cat "$pr_log")" == *"Harden checkout token handling"* ]] ||
    fail "PR body should include release or changelog content"
  [[ "$(cat "$pr_log")" == *"<summary>Changelog</summary>"* ]] ||
    fail "PR body should include a collapsible changelog"
  [[ "$(cat "$pr_log")" == *"Sourced from [actions/checkout's changelog](https://github.com/actions/checkout/blob/main/CHANGELOG.md)."* ]] ||
    fail "PR body should link to changelog source"
  [[ "$(cat "$pr_log")" == *"<summary>Commits</summary>"* ]] ||
    fail "PR body should include collapsible commits"
  [[ "$(cat "$pr_log")" == *"https://github.com/actions/checkout/commit/abc1234"* && "$(cat "$pr_log")" == *"Harden checkout token handling"* ]] ||
    fail "PR body should include compare commits"
  [[ "$(cat "$pr_log")" == *"https://dependabot-badges.githubapp.com/badges/compatibility_score?dependency-name=actions/checkout&package-manager=github_actions&previous-version=2&new-version=4"* ]] ||
    fail "PR body should include the Dependabot compatibility badge"
  [[ "$(cat "$pr_log")" == *"<sub>Findings and PR created by [actions-snitch](https://github.com/wallentx/actions-snitch).</sub>"* ]] ||
    fail "PR body should include the actions-snitch footer"
}

test_pr_targets_push_repository() {
  local mode case_dir repo origin pr_log
  local -a output_args
  for mode in text json; do
    case_dir="$TMP_ROOT/pr-fork-$mode"
    repo="$case_dir/repo"
    origin="$case_dir/fork.git"
    pr_log="$case_dir/pr.log"
    mkdir -p "$repo"
    write_stubs "$case_dir/bin" 90 "$pr_log"
    init_workflow_repo "$repo"
    git -C "$repo" branch -m dev
    git init --bare -q "$origin"
    # Fetch from upstream, push to our fork. Metadata must use the push URL.
    git -C "$repo" remote add origin https://github.com/upstream/fixture.git
    git -C "$repo" remote set-url --push origin "$origin"
    git -C "$repo" push -q -u origin dev
    output_args=()
    if [[ "$mode" == json ]]; then output_args=(-o json); fi
    (cd "$repo" && PATH="$case_dir/bin:$PATH" XDG_CACHE_HOME="$case_dir/cache" \
      TEST_PR_ORIGIN="$origin" TEST_PR_BASE=dev TEST_PR_REPO_URL=https://github.com/fork-owner/fixture \
      GH_REPO=upstream/fixture "$SCRIPT" -p -b actions-update "${output_args[@]}" > "$case_dir/output")
    if [[ "$mode" == json ]]; then jq -e 'type == "object"' "$case_dir/output" >/dev/null; fi
    [[ "$(cat "$pr_log")" == *"--repo https://github.com/fork-owner/fixture"* ]] ||
      fail "PR must target the push repository even when GH_REPO points upstream ($mode)"
    [[ "$(cat "$pr_log")" == *"--head actions-update --base dev"* ]] ||
      fail "PR must target the fork's default branch ($mode)"
    git --git-dir="$origin" show-ref --verify --quiet refs/heads/actions-update ||
      fail "update branch must be pushed to the fork ($mode)"
  done
}

test_pr_target_failure_precedes_changes() {
  local variant case_dir repo before output metadata_failure base
  for variant in missing-origin metadata-error missing-base; do
    case_dir="$TMP_ROOT/pr-target-$variant"
    repo="$case_dir/repo"
    mkdir -p "$repo"
    write_stubs "$case_dir/bin" 90 "$case_dir/pr.log"
    init_workflow_repo "$repo"
    before=$(git -C "$repo" rev-parse HEAD)
    if [[ "$variant" != missing-origin ]]; then
      git -C "$repo" remote add origin https://github.com/fork-owner/fixture.git
    fi
    metadata_failure=false
    base=main
    case "$variant" in
      metadata-error) metadata_failure=true ;;
      missing-base) base="" ;;
    esac
    if output=$(cd "$repo" && PATH="$case_dir/bin:$PATH" XDG_CACHE_HOME="$case_dir/cache" \
      TEST_PR_METADATA_FAILURE="$metadata_failure" TEST_PR_BASE="$base" "$SCRIPT" -p -b actions-update 2>&1); then
      fail "PR target resolution should fail for $variant"
    fi
    [[ "$output" == *"Error:"* ]] || fail "PR target failure should explain the error"
    [[ "$(git -C "$repo" rev-parse HEAD)" == "$before" ]] || fail "target failure must not commit"
    [[ "$(git -C "$repo" branch --show-current)" == main ]] || fail "target failure must not switch branches"
    [[ -z "$(git -C "$repo" status --short)" ]] || fail "target failure must not modify workflows"
    [[ ! -e "$case_dir/pr.log" ]] || fail "target failure must not create a PR"
  done
}

test_pr_body_multiple_updates() {
  local case_dir="$TMP_ROOT/pr-body-multiple"
  local bin_dir="$case_dir/bin"
  local repo="$case_dir/repo"
  local origin="$case_dir/origin.git"
  local pr_log="$case_dir/pr.log"
  local body

  mkdir -p "$repo"
  write_multi_action_stubs "$bin_dir" "$pr_log"
  init_multi_finding_repo "$repo"
  git init --bare -q "$origin"
  git -C "$repo" remote set-url origin "$origin"
  git -C "$repo" push -q -u origin main

  (cd "$repo" && PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/cache" "$SCRIPT" -p -f -b actions-update >/dev/null)

  body=$(cat "$pr_log")
  [[ "$body" == *"Bumps the github-actions group with 2 updates: [actions/checkout](https://github.com/actions/checkout), [docker/setup-buildx-action](https://github.com/docker/setup-buildx-action)."* ]] ||
    fail "multi-action PR body should list both updates in the summary"
  [[ "$body" == *"## [actions/checkout](https://github.com/actions/checkout)"* ]] ||
    fail "multi-action PR body should include a checkout section"
  [[ "$body" == *"## [docker/setup-buildx-action](https://github.com/docker/setup-buildx-action)"* ]] ||
    fail "multi-action PR body should include a buildx section"
  [[ "$body" == *"Updates \`actions/checkout\` from 2 to 4"* ]] ||
    fail "multi-action PR body should describe the checkout update"
  [[ "$body" == *"Updates \`docker/setup-buildx-action\` from 1 to 3"* ]] ||
    fail "multi-action PR body should describe the buildx update"
  [[ "$body" == *"Sourced from [docker/setup-buildx-action's releases](https://github.com/docker/setup-buildx-action/releases)."* ]] ||
    fail "multi-action PR body should link buildx release notes"
  [[ "$body" == *"Sourced from [docker/setup-buildx-action's changelog](https://github.com/docker/setup-buildx-action/blob/main/CHANGELOG.md)."* ]] ||
    fail "multi-action PR body should link buildx changelog"
  [[ "$body" == *"https://github.com/docker/setup-buildx-action/commit/def5678"* && "$body" == *"Improve Buildx setup defaults"* ]] ||
    fail "multi-action PR body should include buildx compare commits"
  [[ "$body" == *"dependency-name=actions/checkout&package-manager=github_actions&previous-version=2&new-version=4"* ]] ||
    fail "multi-action PR body should include the checkout compatibility badge"
  [[ "$body" == *"dependency-name=docker/setup-buildx-action&package-manager=github_actions&previous-version=1&new-version=3"* ]] ||
    fail "multi-action PR body should include the buildx compatibility badge"
  [[ "$body" == *"<sub>Findings and PR created by [actions-snitch](https://github.com/wallentx/actions-snitch).</sub>"* ]] ||
    fail "multi-action PR body should include the actions-snitch footer"
}

test_pr_flow_continues_after_non_semver_latest_release() {
  local case_dir="$TMP_ROOT/non-semver-latest-pr-flow"
  local bin_dir="$case_dir/bin"
  local repo="$case_dir/repo"
  local origin="$case_dir/origin.git"
  local pr_log="$case_dir/pr.log"

  mkdir -p "$repo"
  write_stubs "$bin_dir" 90 "$pr_log"
  init_non_semver_release_repo "$repo"
  git init --bare -q "$origin"
  git -C "$repo" remote add origin "$origin"
  git -C "$repo" push -q -u origin main

  (cd "$repo" && PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/cache" "$SCRIPT" -p -b actions-update >/dev/null)

  [[ "$(workflow_ref "$repo")" == *"actions/checkout@v4"* ]] ||
    fail "-p should update the numeric action before a non-semver latest release"
  [[ "$(workflow_ref "$repo")" == *"github/codeql-action/init@v4"* ]] ||
    fail "-p should leave the non-semver latest release action unchanged"
  [[ "$(git -C "$repo" rev-list --count HEAD)" == "2" ]] ||
    fail "-p should commit updates even after skipping a non-semver latest release"
  [[ -z "$(git -C "$repo" status --short)" ]] ||
    fail "-p should leave the worktree clean after skipping a non-semver latest release"
  git --git-dir="$origin" show-ref --verify --quiet refs/heads/actions-update ||
    fail "-p should push the target branch after skipping a non-semver latest release"
  [[ "$(cat "$pr_log")" == *"Bumps the github-actions group with 1 update: [actions/checkout](https://github.com/actions/checkout)."* ]] ||
    fail "-p should create a PR body for committed updates after skipping a non-semver latest release"
}

test_pr_flow_commits_two_updates_before_non_semver_latest_release() {
  local case_dir="$TMP_ROOT/two-updates-before-non-semver-latest-pr-flow"
  local bin_dir="$case_dir/bin"
  local repo="$case_dir/repo"
  local origin="$case_dir/origin.git"
  local pr_log="$case_dir/pr.log"
  local body

  mkdir -p "$repo"
  write_stubs "$bin_dir" 90 "$pr_log"
  init_two_updates_before_non_semver_release_repo "$repo"
  git init --bare -q "$origin"
  git -C "$repo" remote add origin "$origin"
  git -C "$repo" push -q -u origin main

  (cd "$repo" && PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/cache" "$SCRIPT" -p -b actions-update >/dev/null)

  grep -q 'actions/checkout@v4' "$repo/.github/workflows/actionlint.yml" ||
    fail "-p should update checkout in actionlint before a later non-semver latest release"
  grep -q 'actions/checkout@v4' "$repo/.github/workflows/codeql.yml" ||
    fail "-p should update checkout in codeql before a later non-semver latest release"
  grep -q 'github/codeql-action/init@v4' "$repo/.github/workflows/codeql.yml" ||
    fail "-p should leave the non-semver latest release action unchanged"
  [[ "$(git -C "$repo" rev-list --count HEAD)" == "2" ]] ||
    fail "-p should commit two checkout updates after skipping a later non-semver latest release"
  [[ -z "$(git -C "$repo" status --short)" ]] ||
    fail "-p should leave the worktree clean after committing two checkout updates"
  git --git-dir="$origin" show-ref --verify --quiet refs/heads/actions-update ||
    fail "-p should push two checkout updates after skipping a later non-semver latest release"

  body=$(cat "$pr_log")
  [[ "$body" == *"Bumps the github-actions group with 1 update: [actions/checkout](https://github.com/actions/checkout)."* ]] ||
    fail "-p should create a deduped PR body for the two checkout updates"
  [[ "$body" == *"Updates \`actions/checkout\` from 2 to 4 across 2 workflow entries."* ]] ||
    fail "-p should describe the two checkout references without duplicating release details"
  [[ "$body" != *"github/codeql-action/init"* ]] ||
    fail "-p should not include the skipped non-semver latest release action in the PR body"
}

test_pr_body_ignores_null_release_notes_body() {
  local case_dir="$TMP_ROOT/null-release-notes-pr-body"
  local bin_dir="$case_dir/bin"
  local repo="$case_dir/repo"
  local origin="$case_dir/origin.git"
  local pr_log="$case_dir/pr.log"
  local body

  mkdir -p "$repo"
  write_null_release_body_stubs "$bin_dir" "$pr_log"
  init_workflow_repo "$repo"
  git init --bare -q "$origin"
  git -C "$repo" remote add origin "$origin"
  git -C "$repo" push -q -u origin main

  (cd "$repo" && PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/cache" "$SCRIPT" -p -b actions-update >/dev/null)

  body=$(cat "$pr_log")
  [[ "$body" != *$'\n> null'* ]] ||
    fail "PR body should not include a literal null release-notes body"
  [[ "$body" == *"No release notes were found in [actions/checkout's releases](https://github.com/actions/checkout/releases)."* ]] ||
    fail "PR body should fall back when release notes body is null"
}

test_pr_body_ignores_cached_null_release_notes_body() {
  local case_dir="$TMP_ROOT/cached-null-release-notes-pr-body"
  local bin_dir="$case_dir/bin"
  local repo="$case_dir/repo"
  local origin="$case_dir/origin.git"
  local pr_log="$case_dir/pr.log"
  local cache_dir="$case_dir/cache/actions-snitch"
  local cache_key body

  mkdir -p "$repo" "$cache_dir"
  write_stubs "$bin_dir" 90 "$pr_log"
  init_workflow_repo "$repo"
  git init --bare -q "$origin"
  git -C "$repo" remote add origin "$origin"
  git -C "$repo" push -q -u origin main

  cache_key=$(printf '%s\n' 'gh_api:repos/actions/checkout/releases/tags/v4:.body' | md5sum | cut -d' ' -f1)
  printf 'null\n' > "$cache_dir/$cache_key"

  (cd "$repo" && PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/cache" "$SCRIPT" -p -b actions-update >/dev/null)

  body=$(cat "$pr_log")
  [[ "$body" != *$'\n> null'* ]] ||
    fail "PR body should not include a cached null release-notes body"
  [[ "$body" == *"Sourced from [actions/checkout's releases](https://github.com/actions/checkout/releases)."* ]] ||
    fail "PR body should refetch release notes when cached release notes are null"
}

test_script_avoids_bash4_only_syntax() {
  ! grep -q 'local -A' "$SCRIPT" ||
    fail "actions-snitch should not use Bash 4 associative arrays"
  # shellcheck disable=SC2016
  ! grep -q '\${[^}]*,,[^}]*}' "$SCRIPT" ||
    fail "actions-snitch should not use Bash 4 case-modification expansion"
}

test_pr_body_dedupes_repeated_action_updates() {
  local case_dir="$TMP_ROOT/pr-body-dedupes-repeated-updates"
  local bin_dir="$case_dir/bin"
  local repo="$case_dir/repo"
  local origin="$case_dir/origin.git"
  local pr_log="$case_dir/pr.log"
  local body checkout_sections cache_sections

  mkdir -p "$repo"
  write_stubs "$bin_dir" 90 "$pr_log"
  init_duplicate_pr_body_update_repo "$repo"
  git init --bare -q "$origin"
  git -C "$repo" remote add origin "$origin"
  git -C "$repo" push -q -u origin main

  (cd "$repo" && PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/cache" "$SCRIPT" -p -b actions-update >/dev/null)

  grep -q 'actions/checkout@v4' "$repo/.github/workflows/ci.yml" ||
    fail "-p should update checkout in ci"
  grep -q 'actions/checkout@v4' "$repo/.github/workflows/release.yml" ||
    fail "-p should update checkout in release"
  grep -q 'actions/cache@v6' "$repo/.github/workflows/ci.yml" ||
    fail "-p should update cache in ci"
  grep -q 'actions/cache@v6' "$repo/.github/workflows/release.yml" ||
    fail "-p should update cache in release"

  body=$(cat "$pr_log")
  [[ "$body" == *"Bumps the github-actions group with 2 updates: [actions/checkout](https://github.com/actions/checkout), [actions/cache](https://github.com/actions/cache)."* ]] ||
    fail "PR body should summarize unique action updates"
  [[ "$body" == *"Updates \`actions/checkout\` from 2 to 4 across 2 workflow entries."* ]] ||
    fail "PR body should describe repeated checkout updates once"
  [[ "$body" == *"Updates \`actions/cache\` from 5 to 6 across 2 workflow entries."* ]] ||
    fail "PR body should describe repeated cache updates once"
  checkout_sections=$(grep -o '## \[actions/checkout\]' <<< "$body" | wc -l | tr -d ' ')
  cache_sections=$(grep -o '## \[actions/cache\]' <<< "$body" | wc -l | tr -d ' ')
  [[ "$checkout_sections" == "1" ]] ||
    fail "PR body should include one checkout section"
  [[ "$cache_sections" == "1" ]] ||
    fail "PR body should include one cache section"
  [[ "$body" != *".github/workflows/"* ]] ||
    fail "PR body should not list individual workflow file paths"
}

write_ai_proposal_stub() {
  local bindir="$1"
  cat > "$bindir/llm" <<'LLM'
#!/usr/bin/env bash
set -euo pipefail
prompt=$(cat)
line=$(jq -r '.local_usages[0].action_lines[0]' <<< "$prompt")
if [[ -n "${TEST_TARGET_PATH:-}" ]]; then
  line=$(AI_TEST_PATH="$TEST_TARGET_PATH" yq -r '.. | select(tag == "!!map" and has("uses")) | select(.uses == strenv(AI_TEST_PATH)) | (.uses | line)' .github/workflows/build.yml)
fi
jq -cn --argjson line "$line" --arg input "$TEST_INPUT" \
  --arg current "$TEST_CURRENT" --arg new "$TEST_NEW" '{
  decision: "allow", confidence: "high", summary: "Test proposal",
  findings: [{caution_detail: "Input changed", safety: "Apply the proposed input", evidence: "action_definition"}],
  remediations: [{file: ".github/workflows/build.yml", line: $line, input: $input,
    operation: "set", current_value: $current, new_value: $new, reason: "Test proposal"}]
}'
LLM
  chmod +x "$bindir/llm"
}

test_ai_redaction_variants() {
  local case_dir="$TMP_ROOT/ai-redaction-variants"
  local repo="$case_dir/repo" name
  mkdir -p "$repo"
  write_stubs "$case_dir/bin" 50
  write_ai_stub "$case_dir/bin" allow "$case_dir/llm"
  init_ai_workflow_repo "$repo"
  yq -i '.jobs.build.steps[0].env.LOCAL = "PRIVATE_ENV_MARKER" |
    .jobs.build.steps[0].with.token = "PRIVATE_LITERAL_MARKER" |
    .jobs.build.steps[0].with.githubToken = "PRIVATE_CAMEL_MARKER" |
    .jobs.build.steps[0].with.apiToken = "PRIVATE_API_MARKER" |
    .jobs.build.steps[0].with.clientSecret = "PRIVATE_CLIENT_MARKER" |
    .jobs.build.steps[0].with.authToken = "PRIVATE_AUTH_MARKER"' "$repo/.github/workflows/build.yml"
  for name in bracket nested whitespace context; do
    # shellcheck disable=SC2016
    case "$name" in
      context) TEST_EXPRESSION='${{ toJSON(secrets) }}' ;;
      bracket) TEST_EXPRESSION='${{ secrets['\''PRIVATE_BRACKET_MARKER'\''] }}' ;;
      nested) TEST_EXPRESSION='${{ format("{0}", secrets.PRIVATE_NESTED_MARKER) }}' ;;
      whitespace) TEST_EXPRESSION='${{ SeCrEtS [ "PRIVATE_WHITESPACE_MARKER" ] }}' ;;
    esac
    TEST_NAME="$name" TEST_EXPRESSION="$TEST_EXPRESSION" yq -i '.jobs.build.steps[0].with[strenv(TEST_NAME)] = strenv(TEST_EXPRESSION)' "$repo/.github/workflows/build.yml"
  done
  (cd "$repo" && PATH="$case_dir/bin:$PATH" XDG_CACHE_HOME="$case_dir/cache" ACTIONS_SNITCH_AI=true ACTIONS_SNITCH_AI_MODEL=test-model "$SCRIPT" -u >/dev/null)
  ! grep -q 'PRIVATE_\|CHECKOUT_TOKEN\|TOP_SECRET_MARKER' "$case_dir/llm.prompt" || fail "secret redaction variants leaked into the prompt"
  jq -e '.local_usages[0].document.jobs.build.steps[0] | .env.LOCAL == "<redacted>" and .with.token == "<redacted>" and .with.githubToken == "<redacted>" and .with.context == "<redacted>" and .with["fetch-depth"] == 0' "$case_dir/llm.prompt" >/dev/null || fail "env and with must be independently redacted while preserving safe inputs"
}

test_ai_threshold_policy() {
  local threshold score expected invoked force case_dir output
  while read -r threshold score expected invoked force; do
    case_dir="$TMP_ROOT/ai-threshold-$threshold-$score-$force"
    mkdir -p "$case_dir/repo"
    write_stubs "$case_dir/bin" "$score"
    write_ai_stub "$case_dir/bin" allow "$case_dir/llm"
    init_workflow_repo "$case_dir/repo"
    output=$(cd "$case_dir/repo" && PATH="$case_dir/bin:$PATH" XDG_CACHE_HOME="$case_dir/cache" ACTIONS_SNITCH_AI=true ACTIONS_SNITCH_AI_MODEL=test-model ACTIONS_SNITCH_AI_THRESHOLD="$threshold" "$SCRIPT" -u ${force:+-f})
    [[ "$(workflow_ref "$case_dir/repo")" == *"actions/checkout@v$expected"* ]] || fail "incorrect update gate for threshold $threshold and score $score"
    if [[ "$invoked" == yes ]]; then
      [[ -f "$case_dir/llm.prompt" ]] || fail "AI was not invoked at decimal threshold $threshold"
    else
      [[ ! -f "$case_dir/llm.prompt" ]] || fail "AI was invoked outside threshold $threshold"
    fi
    [[ "$output" != *"value too great for base"* ]] || fail "threshold was parsed as octal"
  done <<'CASES'
50 70 2 no
0 70 2 no
08 7 4 yes
010 9 4 yes
00080 79 4 yes
100 90 4 yes
80 80 4 no
50 70 4 no force
CASES
  for threshold in 101 999999999999999999999999999999999 08x; do
    if (cd "$case_dir/repo" && PATH="$case_dir/bin:$PATH" ACTIONS_SNITCH_AI_THRESHOLD="$threshold" "$SCRIPT" -u >/dev/null 2>&1); then
      fail "invalid threshold $threshold should be rejected"
    fi
  done
}

test_ai_rejects_remediation_variants() {
  local variant case_dir repo input current new original
  for variant in githubToken apiToken clientSecret authToken SSHPrivateKey bracket whitespace nested context map sequence; do
    case_dir="$TMP_ROOT/ai-reject-$variant"
    repo="$case_dir/repo"
    mkdir -p "$repo"
    write_stubs "$case_dir/bin" 50
    write_ai_proposal_stub "$case_dir/bin"
    init_ai_workflow_repo "$repo"
    input="$variant" current=0 new=1
    # shellcheck disable=SC2016
    case "$variant" in
      githubToken|apiToken|clientSecret|authToken|SSHPrivateKey)
        TEST_INPUT="$input" yq -i '.jobs.build.steps[0].with[strenv(TEST_INPUT)] = 0' "$repo/.github/workflows/build.yml" ;;
      context) input=fetch-depth; new='${{ toJSON(secrets) }}' ;;
      bracket) input=fetch-depth; new='${{ secrets['\''TOKEN'\''] }}' ;;
      whitespace) input=fetch-depth; new='${{ SeCrEtS [ "TOKEN" ] }}' ;;
      nested) input=fetch-depth; new='${{ format("{0}", secrets.TOKEN) }}' ;;
      map|sequence)
        input=fetch-depth
        if [[ "$variant" == map ]]; then
          yq -i '.jobs.build.steps[0].with.fetch-depth = {"depth": 0}' "$repo/.github/workflows/build.yml"
        else
          yq -i '.jobs.build.steps[0].with.fetch-depth = [0, 1]' "$repo/.github/workflows/build.yml"
        fi
        current=$(yq -r '.jobs.build.steps[0].with.fetch-depth | tostring' "$repo/.github/workflows/build.yml") ;;
    esac
    original=$(cat "$repo/.github/workflows/build.yml")
    (cd "$repo" && PATH="$case_dir/bin:$PATH" XDG_CACHE_HOME="$case_dir/cache" ACTIONS_SNITCH_AI=true ACTIONS_SNITCH_AI_MODEL=test-model TEST_INPUT="$input" TEST_CURRENT="$current" TEST_NEW="$new" "$SCRIPT" -u >/dev/null)
    [[ "$(cat "$repo/.github/workflows/build.yml")" == "$original" ]] || fail "$variant remediation should leave the entire workflow unchanged"
  done
}

test_ai_missing_required_evidence() {
  local variant case_dir repo original real_yq
  real_yq=$(command -v yq)
  for variant in current-definition latest-definition usage-error empty-usages; do
    case_dir="$TMP_ROOT/ai-missing-$variant"
    repo="$case_dir/repo"
    mkdir -p "$repo"
    write_stubs "$case_dir/bin" 50
    write_ai_stub "$case_dir/bin" allow "$case_dir/llm"
    init_ai_workflow_repo "$repo"
    if [[ "$variant" == *definition ]]; then
      mv "$case_dir/bin/curl" "$case_dir/bin/curl-real"
      cat > "$case_dir/bin/curl" <<'CURL'
#!/usr/bin/env bash
case "$*" in
  *"/$TEST_MISSING_REF/"*action.y*) exit 22 ;;
esac
exec "$(dirname "$0")/curl-real" "$@"
CURL
      chmod +x "$case_dir/bin/curl"
    else
      cat > "$case_dir/bin/yq" <<'YQ'
#!/usr/bin/env bash
if [[ -n "${AI_ACTION_PATH:-}" && "$*" == *action_lines* ]]; then
  [[ "$TEST_EVIDENCE_VARIANT" == empty-usages ]] && exit 0
  exit 1
fi
exec "$TEST_REAL_YQ" "$@"
YQ
      chmod +x "$case_dir/bin/yq"
    fi
    original=$(cat "$repo/.github/workflows/build.yml")
    (cd "$repo" && PATH="$case_dir/bin:$PATH" XDG_CACHE_HOME="$case_dir/cache" ACTIONS_SNITCH_AI=true ACTIONS_SNITCH_AI_MODEL=test-model TEST_MISSING_REF="$([[ "$variant" == current-definition ]] && echo v2 || echo v4)" TEST_REAL_YQ="$real_yq" TEST_EVIDENCE_VARIANT="$variant" "$SCRIPT" -u >/dev/null)
    [[ ! -f "$case_dir/llm.prompt" ]] || fail "$variant should prevent model invocation"
    [[ "$(cat "$repo/.github/workflows/build.yml")" == "$original" ]] || fail "$variant should prevent workflow changes"
  done
}

test_ai_subpath_identity() {
  local case_dir="$TMP_ROOT/ai-subpaths" repo body mode original
  for mode in assess cross-path; do
    repo="$case_dir/$mode/repo"
    mkdir -p "$repo"
    write_stubs "$case_dir/$mode/bin" 50 "$case_dir/$mode/pr.log"
    init_ai_workflow_repo "$repo"
    yq -i '.jobs.build.steps[0].uses = "actions/checkout/foo@v2" |
      .jobs.build.steps[1] = {"uses": "actions/checkout/bar@v2", "with": {"fetch-depth": 0}}' "$repo/.github/workflows/build.yml"
    if [[ "$mode" == assess ]]; then
      cat > "$case_dir/$mode/bin/llm" <<'LLM'
#!/usr/bin/env bash
set -euo pipefail
prompt=$(cat)
printf '%s\n' "$prompt" >> "$TEST_PROMPTS"
jq -cn --arg path "$(jq -r '.upgrade.action_path' <<< "$prompt")" '{
  decision: "allow", confidence: "high", summary: $path,
  findings: [{caution_detail: $path, safety: "Path-specific assessment", evidence: "action_definition"}], remediations: []
}'
LLM
      chmod +x "$case_dir/$mode/bin/llm"
      git -C "$repo" add .
      git -C "$repo" commit -qm 'Add subactions'
      git init --bare -q "$case_dir/$mode/origin.git"
      git -C "$repo" remote add origin "$case_dir/$mode/origin.git"
      git -C "$repo" push -qu origin main
      (cd "$repo" && PATH="$case_dir/$mode/bin:$PATH" XDG_CACHE_HOME="$case_dir/$mode/cache" ACTIONS_SNITCH_AI=true ACTIONS_SNITCH_AI_MODEL=test-model TEST_PROMPTS="$case_dir/prompts" "$SCRIPT" -p -b actions-update >/dev/null)
      jq -se 'length == 2 and ([.[].upgrade.action_path] | sort) == ["actions/checkout/bar", "actions/checkout/foo"] and all(.[]; .local_usages[0].action_lines | length == 1)' "$case_dir/prompts" >/dev/null || fail "subactions need separate assessments and exact usage selectors"
      [[ "$(yq -r '.jobs.build.steps[].uses' "$repo/.github/workflows/build.yml")" == $'actions/checkout/foo@v4\nactions/checkout/bar@v4' ]] || fail "full subaction refs should update"
      body=$(cat "$case_dir/$mode/pr.log")
      [[ "$body" == *'## [actions/checkout/foo]'*'* **Caution Detail:** actions/checkout/foo'*'## [actions/checkout/bar]'*'* **Caution Detail:** actions/checkout/bar'* ]] || fail "PR body must retain each subaction investigation"
    else
      write_ai_proposal_stub "$case_dir/$mode/bin"
      original=$(cat "$repo/.github/workflows/build.yml")
      # Always propose the other path's line so neither assessment can authorize it.
      # shellcheck disable=SC2016
      sed -i '/line=$(jq/a TEST_TARGET_PATH=$(jq -r '\''if .upgrade.action_path | endswith("/foo") then "actions/checkout/bar@v2" else "actions/checkout/foo@v2" end'\'' <<< "$prompt")' "$case_dir/$mode/bin/llm"
      (cd "$repo" && PATH="$case_dir/$mode/bin:$PATH" XDG_CACHE_HOME="$case_dir/$mode/cache" ACTIONS_SNITCH_AI=true ACTIONS_SNITCH_AI_MODEL=test-model TEST_INPUT=fetch-depth TEST_CURRENT=0 TEST_NEW=1 "$SCRIPT" -u >/dev/null)
      [[ "$(cat "$repo/.github/workflows/build.yml")" == "$original" ]] || fail "cross-subaction remediation must be rejected"
    fi
  done
}

test_interactive_config_setup() {
  local case_dir="$TMP_ROOT/config-setup"
  local config_file="$case_dir/xdg/actions-snitch/config.yaml"
  local custom_file="$case_dir/custom/settings.yaml"
  local model='provider/model: "quoted" # literal \\ value'
  local cmd output original

  mkdir -p "$case_dir/bin"
  for cmd in gh curl git llm; do
    printf '#!/usr/bin/env bash\nexit 99\n' > "$case_dir/bin/$cmd"
    chmod +x "$case_dir/bin/$cmd"
  done

  # Setup works outside a repository, without scanning or invoking a provider.
  (cd "$case_dir" && printf '\n\n\n\n\n' | PATH="$case_dir/bin:$PATH" \
    ACTIONS_SNITCH_CONFIG="$config_file" "$SCRIPT" -c >/dev/null 2>&1)
  [[ "$(yq -r '.ai.enabled' "$config_file")" == false ]] || fail "setup should default to AI disabled"
  [[ "$(yq -r '.ai.model' "$config_file")" == "" ]] || fail "disabled AI may omit a model"
  [[ "$(yq -r '.ai.threshold' "$config_file")" == 80 ]] || fail "setup threshold should default to 80"
  [[ "$(yq -r '.ai.issue_search' "$config_file")" == auto ]] || fail "setup issue search should default to auto"
  [[ "$(yq -r '.ai | has("api_key_env")' "$config_file")" == false ]] || fail "setup should omit an empty credential variable"
  [[ "$(LC_ALL=C ls -l "$config_file")" == -rw-------* ]] || fail "config should have owner-only permissions"

  original=$(cat "$config_file")
  if ACTIONS_SNITCH_CONFIG="$config_file" "$SCRIPT" -c </dev/null >/dev/null 2>&1; then
    fail "setup should refuse an existing file"
  fi
  [[ "$(cat "$config_file")" == "$original" ]] || fail "setup overwrote existing settings"

  # Invalid answers must reprompt; model punctuation must survive YAML encoding.
  output=$(printf '%s\n' maybe yes '' "$model" -1 101 2.5 008 always-no never 'not-a-variable' MODEL_API_KEY |
    ACTIONS_SNITCH_CONFIG="$custom_file" XDG_CONFIG_HOME="$case_dir/unused" "$SCRIPT" -c 2>&1)
  [[ "$output" == *'Enter yes or no.'* && "$output" == *'Enter a model ID'* ]] || fail "setup should validate enabled and model answers"
  [[ "$output" == *'Enter an integer from 0 to 100.'* && "$output" == *'Enter auto, always, or never.'* ]] || fail "setup should validate threshold and issue search"
  [[ "$output" == *'Enter an environment variable name'* ]] || fail "setup should validate credential names"
  [[ "$(yq -r '.ai.enabled' "$custom_file")" == true ]] || fail "setup should enable AI when requested"
  [[ "$(yq -r '.ai.model' "$custom_file")" == "$model" ]] || fail "setup should preserve model strings"
  [[ "$(yq -r '.ai.threshold' "$custom_file")" == 8 ]] || fail "setup should normalize decimal thresholds"
  [[ "$(yq -r '.ai.issue_search' "$custom_file")" == never ]] || fail "setup should save the issue search selection"
  [[ "$(yq -r '.ai.api_key_env' "$custom_file")" == MODEL_API_KEY ]] || fail "setup should save the credential variable name"
  [[ ! -e "$case_dir/unused" ]] || fail "explicit config path should override XDG_CONFIG_HOME"

  (unset ACTIONS_SNITCH_CONFIG; printf '\n\n0\nalways\n\n' |
    XDG_CONFIG_HOME="$case_dir/alternate" "$SCRIPT" -c >/dev/null 2>&1)
  [[ -f "$case_dir/alternate/actions-snitch/config.yaml" ]] || fail "setup should respect XDG_CONFIG_HOME"
  (unset ACTIONS_SNITCH_CONFIG XDG_CONFIG_HOME; printf '\n\n100\n\n\n' |
    HOME="$case_dir/home" "$SCRIPT" -c >/dev/null 2>&1)
  [[ -f "$case_dir/home/.config/actions-snitch/config.yaml" ]] || fail "setup should default to HOME/.config"

  if printf 'yes\ntest-model\n' | ACTIONS_SNITCH_CONFIG="$case_dir/cancelled.yaml" "$SCRIPT" -c >/dev/null 2>&1; then
    fail "setup should fail on incomplete input"
  fi
  [[ ! -e "$case_dir/cancelled.yaml" ]] || fail "cancelled setup should not write a config"
  if ACTIONS_SNITCH_CONFIG="$case_dir/mixed.yaml" "$SCRIPT" -c -u </dev/null >/dev/null 2>&1; then
    fail "setup should reject scan options"
  fi
  [[ ! -e "$case_dir/mixed.yaml" ]] || fail "mixed setup options should not write a config"
  ln -s "$case_dir/missing-target" "$case_dir/link.yaml"
  if ACTIONS_SNITCH_CONFIG="$case_dir/link.yaml" "$SCRIPT" -c </dev/null >/dev/null 2>&1; then
    fail "setup should refuse dangling symlinks"
  fi
  [[ ! -e "$case_dir/missing-target" ]] || fail "setup should not follow dangling symlinks"
}

