test_yaml_workflow_and_composite_action_scanning() {
  local case_dir="$TMP_ROOT/yaml-and-composite"
  local bin_dir="$case_dir/bin"
  local repo="$case_dir/repo"
  local repo_name output

  mkdir -p "$repo"
  write_stubs "$bin_dir" 90
  init_yaml_and_composite_repo "$repo"
  repo_name=$(basename "$repo")

  output=$(cd "$repo" && PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/cache" "$SCRIPT" -o json)

  [[ "$(jq -r --arg repo "$repo_name" '[.[$repo][] | select(.file == ".github/workflows/build.yaml" and .action == "actions/checkout@v2")] | length' <<< "$output")" == "1" ]] ||
    fail "scanner should find actions in .yaml workflow files"
  [[ "$(jq -r --arg repo "$repo_name" '[.[$repo][] | select(.file == ".github/actions/helper/action.yml" and .action == "actions/cache@v5")] | length' <<< "$output")" == "1" ]] ||
    fail "scanner should find actions in composite action.yml files"

  (cd "$repo" && PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/cache" "$SCRIPT" -u >/dev/null)

  grep -q 'actions/checkout@v4' "$repo/.github/workflows/build.yaml" ||
    fail "-u should update actions in .yaml workflow files"
  grep -q 'actions/cache@v6' "$repo/.github/actions/helper/action.yml" ||
    fail "-u should update actions in composite action.yml files"
}

test_composite_scan_prunes_excluded_directories() {
  local case_dir="$TMP_ROOT/pruned-directories"
  local bin_dir="$case_dir/bin"
  local repo="$case_dir/repo"
  local output

  mkdir -p "$repo"
  write_stubs "$bin_dir" 90
  init_workflow_repo "$repo"
  mkdir -p "$repo/node_modules"
  chmod 000 "$repo/node_modules"

  output=$(cd "$repo" && PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/cache" "$SCRIPT" -v 2>&1)
  chmod 700 "$repo/node_modules"

  [[ "$output" != *"Permission denied"* ]] ||
    fail "composite action discovery should prune excluded directories"
}

test_pr_flow_stages_composite_action_updates() {
  local case_dir="$TMP_ROOT/composite-pr-flow"
  local bin_dir="$case_dir/bin"
  local repo="$case_dir/repo"
  local origin="$case_dir/origin.git"
