    repos/actions/checkout/releases/latest)
      printf 'v4\\n'
      ;;
    repos/actions/checkout)
      printf 'main\\n'
      ;;
    repos/actions/checkout/releases/tags/v4)
      printf 'null\\n'
      ;;
    repos/actions/checkout/compare/v2...v4)
      printf 'abc1234\\tHarden checkout token handling\\thttps://github.com/actions/checkout/commit/abc1234\\n'
      ;;
    *)
      printf 'unexpected gh api endpoint: %s\\n' "\${2:-}" >&2
      exit 1
      ;;
  esac
elif [[ "\${1:-}" == "repo" && "\${2:-}" == "view" ]]; then
  printf '%s\\n' '{"url":"https://github.com/wallentx/actions-snitch-fixture","defaultBranchRef":{"name":"main"}}'
elif [[ "\${1:-}" == "pr" && "\${2:-}" == "create" ]]; then
  printf '%s\\n' "\$*" > "$pr_log"
else
  printf 'unexpected gh args: %s\\n' "\$*" >&2
  exit 1
fi
GH

  chmod +x "$bindir/gh"
}

init_workflow_repo() {
  local repo="$1"

  mkdir -p "$repo/.github/workflows"
  cat > "$repo/.github/workflows/build.yml" <<'YAML'
name: test
on: workflow_dispatch
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v2
YAML

  git -C "$repo" init -q -b main
  git -C "$repo" config user.email test@example.com
  git -C "$repo" config user.name Test
  git -C "$repo" add .github/workflows/build.yml
  git -C "$repo" commit -q -m init
}

init_ai_workflow_repo() {
  local repo="$1"

  mkdir -p "$repo/.github/workflows"
  cat > "$repo/.github/workflows/build.yml" <<'YAML'
name: test
on: pull_request
permissions:
  contents: read
jobs:
  build:
    runs-on: ubuntu-latest
    env:
      INTERNAL_TOKEN: TOP_SECRET_MARKER
    steps:
      - uses: actions/checkout@v2
        with:
          fetch-depth: 0
          clean: true
          token: ${{ secrets.CHECKOUT_TOKEN }}
      - run: git status --short
YAML

  git -C "$repo" init -q -b main
  git -C "$repo" config user.email test@example.com
  git -C "$repo" config user.name Test
  git -C "$repo" add .github/workflows/build.yml
  git -C "$repo" commit -q -m init
}

init_yaml_and_composite_repo() {
  local repo="$1"

  mkdir -p "$repo/.github/workflows" "$repo/.github/actions/helper"
  cat > "$repo/.github/workflows/build.yaml" <<'YAML'
name: test
on: workflow_dispatch
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v2
YAML
  cat > "$repo/.github/actions/helper/action.yml" <<'YAML'
name: Helper
runs:
  using: composite
  steps:
    - uses: actions/cache@v5
      with:
        path: /tmp/cache
        key: test
YAML

  git -C "$repo" init -q -b main
  git -C "$repo" config user.email test@example.com
  git -C "$repo" config user.name Test
  git -C "$repo" add .github/workflows/build.yaml .github/actions/helper/action.yml
  git -C "$repo" commit -q -m init
}

