#!/usr/bin/env bash
set -euo pipefail

if [[ "${RUNNER_VERBOSE:-0}" -eq 1 ]]; then
  set -x
fi

ROOT=$(git rev-parse --show-toplevel)
SCRIPT="$ROOT/actions-snitch"
TMP_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/actions-snitch-lint-test.XXXXXXXXXX")

# Never load a developer's live AI configuration during fixture tests.
unset ACTIONS_SNITCH_CONFIG ACTIONS_SNITCH_AI ACTIONS_SNITCH_AI_MODEL ACTIONS_SNITCH_AI_THRESHOLD
export XDG_CONFIG_HOME="$TMP_ROOT/config"

cleanup() {
  rm -rf "$TMP_ROOT"
}
trap cleanup EXIT

fail() {
  printf 'lint-test: %s\n' "$*" >&2
  exit 1
}

run_shellcheck() {
  shellcheck --color=always "$SCRIPT" "$ROOT/.github/scripts/lint-test"
}

run_syntax_checks() {
  bash -n "$SCRIPT"
  bash -n "$ROOT/.github/scripts/lint-test"
}

write_stubs() {
  local bindir="$1"
  local score="$2"
  local pr_log="${3:-}"

  mkdir -p "$bindir"

  cat > "$bindir/gh" <<GH
#!/usr/bin/env bash
set -euo pipefail

if [[ "\${1:-}" == "api" ]]; then
  case "\${2:-}" in
    repos/actions/checkout/releases/latest)
      printf 'v4\\n'
      ;;
    repos/actions/cache/releases/latest)
      printf 'v6\\n'
      ;;
    repos/github/codeql-action/releases/latest)
      printf 'codeql-bundle-v2.23.0\\n'
      ;;
    repos/actions/checkout)
      printf 'main\\n'
      ;;
    repos/actions/cache)
      printf 'main\\n'
      ;;
    repos/actions/checkout/releases/tags/v4)
      exit 1
      ;;
    'repos/actions/checkout/releases?per_page=100')
      printf 'v4.0.0\\tHarden checkout token handling\\thttps://github.com/actions/checkout/releases/tag/v4.0.0\\n'
      ;;
    repos/actions/cache/releases/tags/v6)
      printf '## What changed\\n- Improve cache lookup behavior\\n'
      ;;
    repos/actions/checkout/compare/v2...v4)
      printf 'abc1234\\tHarden checkout token handling\\thttps://github.com/actions/checkout/commit/abc1234\\n'
      ;;
    repos/actions/cache/compare/v5...v6)
      printf 'cab6789\\tImprove cache lookup behavior\\thttps://github.com/actions/cache/commit/cab6789\\n'
      ;;
    search/issues)
      printf 'Checkout v4 regression\\thttps://github.com/actions/checkout/issues/999\\tclosed\\tFixed in v4\\n'
      ;;
    *)
      printf 'unexpected gh api endpoint: %s\\n' "\${2:-}" >&2
      exit 1
      ;;
  esac
elif [[ "\${1:-}" == "repo" && "\${2:-}" == "view" ]]; then
  if [[ -n "\${TEST_PR_ORIGIN:-}" && "\${3:-}" != "\$TEST_PR_ORIGIN" ]]; then
    printf 'PR metadata must be fetched from the origin push URL\\n' >&2
    exit 1
  fi
  if [[ "\${TEST_PR_METADATA_FAILURE:-}" == true ]]; then exit 1; fi
  jq -cn --arg url "\${TEST_PR_REPO_URL:-https://github.com/wallentx/actions-snitch-fixture}" \\
    --arg base "\${TEST_PR_BASE-main}" '{url: \$url, defaultBranchRef: {name: \$base}}'
elif [[ "\${1:-}" == "pr" && "\${2:-}" == "create" ]]; then
  printf '%s\\n' "\$*" > "$pr_log"
else
  printf 'unexpected gh args: %s\\n' "\$*" >&2
  exit 1
fi
GH

  cat > "$bindir/curl" <<CURL
#!/usr/bin/env bash
set -euo pipefail

case "\$*" in
  *dependabot-badges.githubapp.com*)
    printf '%s\\n' '<svg><title>compatibility: $score%</title></svg>'
    ;;
  *raw.githubusercontent.com/actions/checkout*/action.y*)
    printf '%s\\n' 'name: Checkout'
    ;;
  *raw.githubusercontent.com/actions/checkout*/CHANGELOG.md*)
    printf '%s\\n' '## v4' '- Harden checkout token handling'
    ;;
  *raw.githubusercontent.com/actions/cache*/action.y*)
    printf '%s\\n' 'name: Cache'
    ;;
  *raw.githubusercontent.com/actions/cache*/CHANGELOG.md*)
    printf '%s\\n' '## v6' '- Improve cache lookup behavior'
    ;;
  *github.com/marketplace/actions/checkout*)
    printf '%s\\n' 'GitHub has manually verified the creator of the action as an official partner organization.'
    ;;
  *github.com/marketplace/actions/cache*)
    printf '%s\\n' 'GitHub has manually verified the creator of the action as an official partner organization.'
    ;;
  *)
    printf 'unexpected curl args: %s\\n' "\$*" >&2
    exit 1
    ;;
esac
CURL

  chmod +x "$bindir/gh" "$bindir/curl"
}

write_ai_stub() {
  local bindir="$1"
  local decision="$2"
  local llm_log="$3"

  cat > "$bindir/llm" <<LLM
#!/usr/bin/env bash
set -euo pipefail

printf '%s\\n' "\$*" > "${llm_log}.args"
prompt=\$(cat)
printf '%s' "\$prompt" > "${llm_log}.prompt"

case "$decision" in
  invalid)
    printf 'not-json\\n'
    ;;
  remediate)
    line=\$(jq -r '.local_usages[0].action_lines[0]' <<< "\$prompt")
    jq -cn --argjson line "\$line" '{
      decision: "allow",
      confidence: "high",
      summary: "The checkout upgrade is compatible after changing fetch-depth.",
      findings: [{
        caution_detail: "Checkout fetch behavior changed.",
        safety: "Using fetch-depth 1 avoids the incompatible full-history behavior.",
        evidence: "release_notes"
      }],
      remediations: [
        {
          file: ".github/workflows/build.yml",
          line: \$line,
          input: "fetch-depth",
          operation: "set",
          current_value: "0",
          new_value: "1",
          reason: "The proposed version requires a shallow checkout in this workflow."
        },
        {
          file: ".github/workflows/build.yml",
          line: \$line,
          input: "clean",
          operation: "remove",
          current_value: "true",
          new_value: "<removed>",
          reason: "The proposed version should use its new clean default."
        }
      ]
    }'
    ;;
  unsafe-remediation)
    line=\$(jq -r '.local_usages[0].action_lines[0]' <<< "\$prompt")
    jq -cn --argjson line "\$line" '{
      decision: "allow",
      confidence: "high",
      summary: "Unsafe remediation proposal.",
      findings: [{
        caution_detail: "Token behavior changed.",
        safety: "A token change was proposed.",
        evidence: "release_notes"
      }],
      remediations: [
        {
          file: ".github/workflows/build.yml",
          line: \$line,
          input: "fetch-depth",
          operation: "set",
          current_value: "0",
          new_value: "1",
          reason: "This valid change must not be partially applied."
        },
        {
          file: ".github/workflows/build.yml",
          line: \$line,
          input: "token",
          operation: "set",
          current_value: "<redacted>",
          new_value: "unsafe",
          reason: "This must be rejected as a sensitive input."
        }
      ]
    }'
    ;;
  *)
    printf '%s\\n' '{"decision":"$decision","confidence":"high","summary":"The observed checkout configuration is compatible with v4.","findings":[{"caution_detail":"Checkout token handling changed.","safety":"The workflow uses an explicit token and remains compatible.","evidence":"release_notes"}],"remediations":[]}'
    ;;
esac
LLM

  chmod +x "$bindir/llm"
}

write_multi_action_stubs() {
  local bindir="$1"
  local pr_log="${2:-}"

  mkdir -p "$bindir"

  cat > "$bindir/gh" <<GH
#!/usr/bin/env bash
set -euo pipefail

if [[ "\${1:-}" == "api" ]]; then
  case "\${2:-}" in
    repos/actions/checkout/releases/latest)
      printf 'v4\n'
      ;;
    repos/actions/checkout)
      printf 'main\n'
      ;;
    repos/actions/checkout/releases/tags/v4)
      printf '## What changed\n- Harden checkout token handling\n'
      ;;
    repos/actions/checkout/compare/v2...v4)
      printf 'abc1234\tHarden checkout token handling\thttps://github.com/actions/checkout/commit/abc1234\n'
      ;;
    repos/docker/setup-buildx-action/releases/latest)
      printf 'v3\n'
      ;;
    repos/docker/setup-buildx-action)
      printf 'main\n'
      ;;
    repos/docker/setup-buildx-action/releases/tags/v3)
      printf '## What changed\n- Improve Buildx setup defaults\n'
      ;;
    repos/docker/setup-buildx-action/compare/v1...v3)
      printf 'def5678\tImprove Buildx setup defaults\thttps://github.com/docker/setup-buildx-action/commit/def5678\n'
      ;;
    *)
      printf 'unexpected gh api endpoint: %s\n' "\${2:-}" >&2
      exit 1
      ;;
  esac
elif [[ "\${1:-}" == "repo" && "\${2:-}" == "view" ]]; then
  printf '%s\n' '{"url":"https://github.com/wallentx/actions-snitch-fixture","defaultBranchRef":{"name":"main"}}'
elif [[ "\${1:-}" == "pr" && "\${2:-}" == "create" ]]; then
  printf '%s\n' "\$*" > "$pr_log"
else
  printf 'unexpected gh args: %s\n' "\$*" >&2
  exit 1
fi
GH

  cat > "$bindir/curl" <<'CURL'
#!/usr/bin/env bash
set -euo pipefail

case "$*" in
  *dependency-name=actions/checkout*)
    printf '%s\n' '<svg><title>compatibility: 90%</title></svg>'
    ;;
  *dependency-name=docker/setup-buildx-action*)
    printf '%s\n' '<svg><title>compatibility: 50%</title></svg>'
    ;;
  *raw.githubusercontent.com/actions/checkout*/action.y*)
    printf '%s\n' 'name: Checkout'
    ;;
  *raw.githubusercontent.com/actions/checkout*/CHANGELOG.md*)
    printf '%s\n' '## v4' '- Harden checkout token handling'
    ;;
  *raw.githubusercontent.com/docker/setup-buildx-action*/action.y*)
    printf '%s\n' 'name: Docker Setup Buildx'
    ;;
  *raw.githubusercontent.com/docker/setup-buildx-action*/CHANGELOG.md*)
    printf '%s\n' '## v3' '- Improve Buildx setup defaults'
    ;;
  *github.com/marketplace/actions/checkout*)
    printf '%s\n' 'GitHub has manually verified the creator of the action as an official partner organization.'
    ;;
  *github.com/marketplace/actions/docker-setup-buildx*)
    printf '%s\n' 'No verified badge on this page.'
    ;;
  *)
    printf 'unexpected curl args: %s\n' "$*" >&2
    exit 1
    ;;
esac
CURL

  chmod +x "$bindir/gh" "$bindir/curl"
}

write_sha_stubs() {
  local bindir="$1" score="${2:-90}" pr_log="${3:-}"
  write_stubs "$bindir" "$score" "$pr_log"
  mv "$bindir/gh" "$bindir/base-gh"
  cat > "$bindir/gh" <<'GH'
#!/usr/bin/env bash
set -euo pipefail
if [[ "${1:-}" != api ]]; then exec "$(dirname "$0")/base-gh" "$@"; fi
endpoint="$2"
shift 2
query='.'
query_given=false
paginate=false
slurp=false
while (( $# )); do
  case "$1" in
    --jq) query="$2"; query_given=true; shift ;;
    --paginate) paginate=true ;;
    --slurp) slurp=true ;;
  esac
  shift
done
if $slurp && $query_given; then exit 1; fi
case "$endpoint" in
  repos/actions/checkout/releases/latest)
    [[ "${TEST_SHA_NO_RELEASE:-false}" != true ]] || exit 1
    jq -n --arg tag "${TEST_SHA_RELEASE:-v7.0.1}" '{tag_name:$tag}' | jq -r "$query"
    ;;
  repos/actions/checkout)
    printf '{"default_branch":"main"}' | jq -r "$query"
    ;;
  repos/actions/checkout/commits/*)
    expected_ref="${TEST_SHA_RELEASE:-v7.0.1}"
    if [[ "${TEST_SHA_NO_RELEASE:-false}" == true ]]; then expected_ref=main; fi
    [[ "$endpoint" == "repos/actions/checkout/commits/$expected_ref" ]] || exit 1
    [[ "${TEST_SHA_RESOLVE_FAIL:-false}" != true ]] || exit 1
    jq -n --arg sha "${TEST_SHA_LATEST:-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb}" '{sha:$sha}' | jq -r "$query"
    ;;
  repos/actions/checkout/compare/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa...bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb)
    [[ "${TEST_SHA_COMPARE_FAIL:-false}" != true ]] || exit 1
    jq -n --arg status "${TEST_SHA_STATUS:-ahead}" --argjson count "${TEST_SHA_COUNT:-302}" \
      '{status:$status, ahead_by:$count, behind_by:0}' | jq -r "$query"
    ;;
  'repos/actions/checkout/tags?per_page=100')
    $paginate && $slurp || { printf 'tags must fetch all pages\n' >&2; exit 1; }
    [[ "${TEST_SHA_TAGS_FAIL:-false}" != true ]] || exit 1
    if [[ "${TEST_SHA_NUMERIC_TAG:-false}" == true ]]; then
      printf '[[{"name":"6","commit":{"sha":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}}]]'
    elif [[ "${TEST_SHA_UNTAGGED:-false}" == true ]]; then
      printf '[[]]'
    else
      # Exact full tags live on page two; v6 is a moving alias on page one.
      printf '[[{"name":"v6","commit":{"sha":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}}],'
      printf '[{"name":"v6.2.0","commit":{"sha":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}},'
      printf '{"name":"v6.1.0","commit":{"sha":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}}]]'
    fi
    ;;
  *) exec "$(dirname "$0")/base-gh" api "$endpoint" --jq "$query" ;;
esac
GH
  chmod +x "$bindir/gh"
}

write_commit_sha_default_branch_stubs() {
  write_sha_stubs "$1"
}

write_commit_sha_release_stubs() {
  write_sha_stubs "$1"
}

