  write_stubs "$bin_dir" 90 "$pr_log"
  init_yaml_and_composite_repo "$repo"
  git init --bare -q "$origin"
  git -C "$repo" remote add origin "$origin"
  git -C "$repo" push -q -u origin main

  (cd "$repo" && PATH="$bin_dir:$PATH" XDG_CACHE_HOME="$case_dir/cache" "$SCRIPT" -p -b actions-update >/dev/null)

  git -C "$repo" diff-tree --no-commit-id --name-only -r HEAD | grep -q '^.github/actions/helper/action.yml$' ||
    fail "-p should include composite action updates in the commit"
  [[ -z "$(git -C "$repo" status --short)" ]] ||
    fail "-p should leave the worktree clean after committing composite action updates"
}

